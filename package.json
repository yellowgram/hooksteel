{
  "name": "hooksteel",
  "version": "0.1.0",
  "private": true,
  "description": "Billing event reliability kit: Stripe signed webhooks, same-transaction outbox, minimal drain.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "migrate": "tsx src/db/migrate.ts",
    "outbox:drain": "tsx scripts/outbox-drain.ts",
    "test": "tsx --test --test-concurrency=1 tests/unit/*.test.ts tests/chaos/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "dotenv": "^16.4.7",
    "pg": "^8.13.1",
    "stripe": "^17.7.0"
  },
  "devDependencies": {
    "@types/node": "^20.17.16",
    "@types/pg": "^8.11.11",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
