{
  "name": "hooksteel",
  "version": "0.1.1",
  "license": "LicenseRef-PolyForm-Noncommercial-1.0.0",
  "private": true,
  "description": "Billing event reliability kit: Stripe and Polar signed webhooks, same-transaction outbox, minimal drain.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "migrate": "tsx src/db/migrate.ts",
    "outbox:drain": "tsx scripts/outbox-drain.ts",
    "replay:list": "tsx scripts/replay-cli.ts list",
    "replay:dry-run": "tsx scripts/replay-cli.ts dry-run",
    "replay:execute": "tsx scripts/replay-cli.ts execute",
    "demo": "npm run demo:60s",
    "demo:60s": "tsx --test --test-concurrency=1 tests/chaos/01-duplicate-delivery.test.ts tests/chaos/05-db-rollback-mid-fulfillment.test.ts",
    "pack:release": "bash scripts/pack-release.sh",
    "test": "tsx --test --test-concurrency=1 tests/unit/*.test.ts tests/chaos/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "dotenv": "^16.4.7",
    "pg": "^8.13.1",
    "stripe": "^17.7.0"
  },
  "devDependencies": {
    "@types/node": "^20.17.16",
    "@types/pg": "^8.11.11",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
