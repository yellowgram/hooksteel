# Next.js loads this directory's .env.local (not the repo-root .env).
# Variable names match the root .env.example. Copy to .env.local and fill them in.
#
#   cp .env.example .env.local
#
# Use the whsec_ from `stripe listen --forward-to localhost:3000/api/webhooks/stripe`.
# That CLI secret is not the Dashboard endpoint secret.

DATABASE_URL=postgres://postgres:postgres@localhost:5432/hooksteel
STRIPE_WEBHOOK_SECRET=whsec_replace_me
STRIPE_EXPECT_LIVEMODE=false
